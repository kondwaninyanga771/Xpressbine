APP_NAME=Xpressbine
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lusaka
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Persistent store. json writes storage/app/data/db.json. database uses DB_* below.
XPRESSBINE_DATA_DRIVER=json

# Used only when XPRESSBINE_DATA_DRIVER=database.
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# PostgreSQL (preferred once you have a server). Distance search uses Haversine SQL here.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=xpressbine
# DB_USERNAME=xpressbine
# DB_PASSWORD=xpressbine

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# The React UI is client-rendered. Leave SSR off unless a Node renderer is running.
INERTIA_SSR_ENABLED=false

# Suggested defaults from the system definition. All are optional.
XPRESSBINE_CURRENCY=ZMW
XPRESSBINE_COMMISSION_RATE=0.12
XPRESSBINE_CLAIM_WINDOW_HOURS=48
XPRESSBINE_AUTO_RELEASE_HOURS=48
XPRESSBINE_FULL_REFUND_CANCEL_HOURS=24
XPRESSBINE_LATE_CANCEL_FEE_RATE=0.15
XPRESSBINE_CALL_OUT_FEE_RATE=0.15
XPRESSBINE_NO_SHOW_GRACE_MINUTES=60
XPRESSBINE_AI_DRIVER=mock
# XPRESSBINE_AI_DRIVER=llm
# XPRESSBINE_AI_API_KEY=
# XPRESSBINE_AI_BASE_URL=https://api.openai.com/v1
# XPRESSBINE_AI_MODEL=gpt-4o-mini
